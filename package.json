{
  "name": "compound-interest-calculator-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:core",
    "build:core": "tsc -p tsconfig.build.json",
    "build:app": "next build --webpack",
    "dev": "next dev --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "rules": "cat docs/DEVELOPMENT_GOLDEN_RULES.md",
    "verify": "npm run typecheck && npm run test && npm run build:app"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "next": "16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  }
}